runtime bottle-vm@0.2
module test.float_array

// Test integer array with literal
state int_arr[5] = [1, 2, 3, 4, 5]

// Test float array with literal
state float_arr[5] = [0.5, 1.0, 1.5, 2.0, 2.5]

// Test mixed initialization (should infer float type)
state mixed_arr[4] = [1, 2.5, 3, 4.0]

// Test scalar for output
state result = 0.0

frame_ms 100

setup {
  clear(LEDS)
  print(int_arr[0])
  print(int_arr[4])
  print(float_arr[0])
  print(float_arr[4])
  print(mixed_arr[1])
}

loop {
  // Test array access and arithmetic
  result = float_arr[0] + float_arr[1]
  print(result)

  // Test array modification
  float_arr[0] = float_arr[0] + 0.1

  // Visualize on LEDs
  clear(LEDS)
  for x in range(0, 5) {
    if x < int_arr[x] {
      LEDS[x, 0] = rgb(255, 0, 0)
    }
    if x < float_arr[x] {
      LEDS[x, 1] = rgb(0, 255, 0)
    }
  }
  show(LEDS)
}

unload {
  clear(LEDS)
  show(LEDS)
}
