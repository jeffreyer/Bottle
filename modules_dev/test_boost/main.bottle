runtime bottle-vm@0.2
module test.boost

state spectrum[5] = 100
state boost[5] = [0.5, 1.0, 1.5, 2.0, 2.5]
state result[5] = 0

frame_ms 100

setup {
  clear(LEDS)
}

loop {
  for x in spectrum {
    result[x] = spectrum[x] * boost[x]
    print(result[x])
  }
}

unload {
  clear(LEDS)
  show(LEDS)
}
